import { useState } from 'react'
import { ArrowDownLeft, ArrowUpRight, ChevronDown, Link2, Plus, Search, X } from 'lucide-react'
import type { WorkflowStudioState } from '../useWorkflowStudio'
import type { WorkflowCatalogItem, WorkflowNode } from '../workflowTypes'
import { WorkflowToolIcon } from '../WorkflowToolIcon'
import { uid } from '../workflowUtils'

type Side = 'input' | 'output'
type Branch = 'true' | 'false'
type Props = { studio: WorkflowStudioState; side: Side; mode?: 'inline' | 'popover'; onClose?: () => void; initialSearch?: string }

const handlesKey = '__cliptora_ui_source_handles'

function labelOf(node: WorkflowNode, catalog: WorkflowCatalogItem[]) {
  const custom = node.settings.__cliptora_ui_label
  return typeof custom === 'string' && custom.trim()
    ? custom.trim()
    : catalog.find(item => item.type === node.type)?.label ?? 'Workflow node'
}

function isEntry(type: string) {
  return type === 'core.video_source' || /(?:^|[._-])(trigger|webhook|schedule|cron)(?:$|[._-])/.test(type)
}

function hasAncestor(nodes: WorkflowNode[], nodeId: string, ancestorId: string) {
  const byId = new Map(nodes.map(node => [node.id, node]))
  const visited = new Set<string>()
  const pending = [...(byId.get(nodeId)?.depends_on ?? [])]
  while (pending.length) {
    const id = pending.pop()!
    if (id === ancestorId) return true
    if (visited.has(id)) continue
    visited.add(id)
    pending.push(...(byId.get(id)?.depends_on ?? []))
  }
  return false
}

function isCompatible(source: WorkflowCatalogItem | undefined, target: WorkflowCatalogItem | undefined) {
  const outputs = source?.output_types ?? []
  const inputs = target?.input_types ?? []
  if (!outputs.length || !inputs.length) return true
  return outputs.includes('any') || inputs.includes('any') ||
    outputs.some(kind => inputs.includes(kind))
}

function score(source: WorkflowCatalogItem | undefined, target: WorkflowCatalogItem | undefined) {
  let rank = 0
  if (!source || !target) return rank
  const outputs = source.output_types ?? []
  const inputs = target.input_types ?? []
  if (outputs.length && inputs.length && outputs.some(t => inputs.includes(t))) rank += 30
  if (source.group === target.group) rank += 5
  if (source.type === 'core.video_source' && /media\.|video\.|audio\./.test(target.type)) rank += 12
  if (/media\.|video\.|audio\./.test(source.type) && /media\.|video\.|audio\./.test(target.type)) rank += 3
  return rank
}

function branchSettings(settings: Record<string, unknown>, sourceId: string, branch: Branch) {
  const raw = settings[handlesKey]
  const handles = raw && typeof raw === 'object' && !Array.isArray(raw)
    ? raw as Record<string, unknown>
    : {}
  return { ...settings, [handlesKey]: { ...handles, [sourceId]: branch } }
}

function nodeIcon(node: WorkflowNode, catalog: WorkflowCatalogItem[]) {
  return <WorkflowToolIcon label={labelOf(node, catalog)} type={node.type} size={21} />
}

export function WorkflowNodeConnections({ studio, side, mode = 'inline', onClose, initialSearch = '' }: Props) {
  const { selected, nodes, catalog, setNodes, setSelectedId, setMessage, working } = studio
  const [showSuggestions, setShowSuggestions] = useState(false)
  const [search, setSearch] = useState(initialSearch)
  const [showAll, setShowAll] = useState(false)
  const input = side === 'input'
  const popover = mode === 'popover'
  if (!selected) return null

  const connected = input
    ? selected.depends_on.map(id => nodes.find(node => node.id === id)).filter((node): node is WorkflowNode => Boolean(node))
    : nodes.filter(node => node.depends_on.includes(selected.id))

  const available = catalog.filter(item => item.status === 'implemented')
  const selectedCatalog = catalog.find(item => item.type === selected.type)
  const isPossible = (candidate: WorkflowNode | WorkflowCatalogItem, existing: boolean) => {
    if (candidate.type === selected.type && !existing && candidate.type === 'core.video_source') return false
    if (input && isEntry(selected.type)) return false
    if (!input && isEntry(candidate.type)) return false
    if (existing && 'id' in candidate) {
      if (candidate.id === selected.id) return false
      const sourceId = input ? candidate.id : selected.id
      const targetId = input ? selected.id : candidate.id
      if (hasAncestor(nodes, sourceId, targetId)) return false
      if (input ? selected.depends_on.includes(candidate.id) : candidate.depends_on.includes(selected.id)) return false
    }
    if (!existing && candidate.type === 'core.video_source' && nodes.some(node => node.type === candidate.type)) return false
    const sourceCatalog = input ? catalog.find(item => item.type === candidate.type) : selectedCatalog
    const targetCatalog = input ? selectedCatalog : catalog.find(item => item.type === candidate.type)
    return isCompatible(sourceCatalog, targetCatalog)
  }

  const candidatesInFlow = nodes.filter(node => isPossible(node, true))
    .sort((a, b) => score(input ? catalog.find(c => c.type === b.type) : selectedCatalog, input ? selectedCatalog : catalog.find(c => c.type === b.type)) -
      score(input ? catalog.find(c => c.type === a.type) : selectedCatalog, input ? selectedCatalog : catalog.find(c => c.type === a.type)))

  const candidatesNew = available.filter(item => isPossible(item, false))
    .sort((a, b) => score(input ? b : selectedCatalog, input ? selectedCatalog : b) -
      score(input ? a : selectedCatalog, input ? selectedCatalog : a))

  const normalized = search.toLowerCase().trim()
  const matches = (value: string) => !normalized || value.toLowerCase().includes(normalized)
  const existingMatches = candidatesInFlow.filter(node => matches(`${labelOf(node, catalog)} ${catalog.find(item => item.type === node.type)?.group ?? ''}`))
  const newMatches = candidatesNew.filter(item => matches(`${item.label} ${item.group} ${item.description ?? ''}`))
  const limit = showAll ? 100 : 8

  function attach(sourceId: string, targetId: string, branch?: Branch) {
    if (sourceId === targetId || hasAncestor(nodes, sourceId, targetId)) return
    setNodes(previous => previous.map(node => {
      if (node.id !== targetId || node.depends_on.includes(sourceId)) return node
      const next = { ...node, depends_on: [...node.depends_on, sourceId] }
      if (branch) {
        next.settings = branchSettings(node.settings, sourceId, branch)
        next.when = branch === 'true' ? 'condition_true' : 'condition_false'
      }
      return next
    }))
    setMessage('Nodes connected. Save the workflow to persist changes.')
    setShowSuggestions(false)
    onClose?.()
  }

  function attachExisting(node: WorkflowNode, branch?: Branch) {
    attach(input ? node.id : selected.id, input ? selected.id : node.id, branch)
  }

  function addAndAttach(item: WorkflowCatalogItem, branch?: Branch) {
    if (working || nodes.length >= 100) return
    setNodes(previous => {
      if (previous.length >= 100 || !previous.some(node => node.id === selected.id)) return previous
      const id = uid(item.type, previous.map(node => node.id))
      const anchor = selected.position ?? { x: 150, y: 130 }
      const sibling = previous.filter(node => input
        ? node.depends_on.includes(selected.id) === false && node.position && node.position.x < anchor.x
        : node.depends_on.includes(selected.id)).length
      const position = {
        x: anchor.x + (input ? -310 : 310),
        y: anchor.y + (sibling % 4) * 115,
      }
      const settings = structuredClone(item.settings)
      const sourceId = input ? id : selected.id
      const newNode: WorkflowNode = {
        id, type: item.type, depends_on: input ? [] : [selected.id],
        when: 'always', retry_limit: 1, cache: true,
        settings: !input && branch ? branchSettings(settings, selected.id, branch) : settings,
        position,
      }
      if (!input && branch) newNode.when = branch === 'true' ? 'condition_true' : 'condition_false'
      if (!input) return [...previous, newNode]
      return [...previous.map(node => node.id === selected.id ? {
        ...node,
        depends_on: [...node.depends_on, id],
        when: branch ? (branch === 'true' ? 'condition_true' : 'condition_false') : node.when,
        settings: branch ? branchSettings(node.settings, sourceId, branch) : node.settings,
      } : node), newNode]
    })
    setMessage('Node added and connected. Save the workflow to persist changes.')
    setShowSuggestions(false)
    onClose?.()
  }

  const suggest = popover || connected.length === 0 || showSuggestions
  const connectorLabel = input ? 'Previous nodes' : 'Next nodes'
  const emptyLabel = input ? 'No incoming connection' : 'No outgoing connection'
  const actionClass = 'shrink-0 cursor-pointer rounded-md px-2 py-1 text-[11px] font-medium text-violet-700 hover:bg-violet-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-violet-500 disabled:cursor-not-allowed disabled:opacity-40'

  function actions(sourceType: string, activate: (branch?: Branch) => void, adding = false) {
    return sourceType === 'flow.if'
      ? <span className="flex shrink-0 items-center gap-1">
          <button type="button" className={actionClass} disabled={working || (adding && nodes.length >= 100)} onClick={() => activate('true')} title="Use the True branch">True</button>
          <button type="button" className={actionClass} disabled={working || (adding && nodes.length >= 100)} onClick={() => activate('false')} title="Use the False branch">False</button>
        </span>
      : <button type="button" className={actionClass} disabled={working || (adding && nodes.length >= 100)} onClick={() => activate()} aria-label="Connect node"><Plus size={16} /></button>
  }

  return <div className={popover ? 'overflow-hidden rounded-xl border border-[#e4e4e7] bg-white' : 'shrink-0 border-b border-[#e4e4e7] bg-white'} data-connection-side={side}>
    {popover && <div className="flex h-11 items-center justify-between border-b border-[#ececec] px-3">
      <span className="text-[12px] font-semibold text-[#333]">{input ? 'Choose previous node' : 'Choose next node'}</span>
      <button type="button" onClick={onClose} aria-label="Close node suggestions" className="grid size-7 cursor-pointer place-items-center rounded-md text-[#777] hover:bg-[#f4f4f4]"><X size={16} /></button>
    </div>}
    {!popover && <div className="flex min-h-10 items-center justify-between gap-2 px-3">
      <span className="inline-flex min-w-0 items-center gap-1.5 text-[12px] font-medium text-[#494949]">
        {input ? <ArrowDownLeft size={15} className="text-[#777]" /> : <ArrowUpRight size={15} className="text-[#777]" />}
        {connectorLabel}
        <span className="ml-1 rounded-md bg-[#f0f0f2] px-1.5 text-[10px] tabular-nums text-[#727272]">{connected.length}</span>
      </span>
      <button type="button" disabled={working || (input && isEntry(selected.type))}
        onClick={() => setShowSuggestions(current => !current)}
        className="inline-flex cursor-pointer items-center gap-1 text-[11px] font-medium text-[#7654b6] hover:text-[#57328f] disabled:cursor-not-allowed disabled:opacity-35">
        {connected.length === 0 ? 'Suggestions' : showSuggestions ? 'Hide suggestions' : 'Add connection'}
        <ChevronDown size={13} className={suggest && connected.length > 0 ? 'rotate-180' : ''} />
      </button>
    </div>}

    {!popover && (connected.length ? <div className="max-h-28 overflow-y-auto px-3 pb-2 [scrollbar-width:thin]">
      {connected.map(node => {
        const state = studio.run?.results?.[node.id]?.state
        return <button type="button" key={node.id} onClick={() => setSelectedId(node.id)}
          title={`Open ${labelOf(node, catalog)}`}
          className="flex w-full cursor-pointer items-center gap-2 border-t border-[#f0f0f0] px-1 py-2 text-left hover:bg-[#f8f7fb] focus-visible:outline focus-visible:outline-2 focus-visible:outline-violet-500">
          {nodeIcon(node, catalog)}
          <span className="min-w-0 flex-1 truncate text-[12px] font-medium text-[#393939]">{labelOf(node, catalog)}</span>
          {state && <span className="truncate text-[10px] text-[#999]">{state}</span>}
          <Link2 size={13} className="shrink-0 text-[#999]" />
        </button>
      })}
    </div> : <p className="px-4 pb-2 text-[11px] text-[#929292]">{emptyLabel}. {input ? 'Choose a node to send data here.' : 'Choose a node to receive this output.'}</p>)}

    {popover && connected.length > 0 && <div className="max-h-[120px] overflow-y-auto border-b border-[#ececf0] [scrollbar-width:thin]">
      <p className="px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.1em] text-[#999]">Connected nodes</p>
      {connected.map(node => <button key={node.id} type="button" onClick={() => { setSelectedId(node.id); onClose?.() }}
        className="flex w-full cursor-pointer items-center gap-2 px-3 py-1.5 text-left hover:bg-[#f7f7f7]">
        {nodeIcon(node, catalog)}<span className="min-w-0 flex-1 truncate text-[12px]">{labelOf(node, catalog)}</span>
      </button>)}
    </div>}

    {suggest && !(input && isEntry(selected.type)) && <div className="border-t border-[#ececf0] bg-[#fafafa]">
      <div className="flex items-center gap-2 px-3 py-2">
        <Search size={14} className="text-[#999]" />
        <input type="search" value={search} onChange={event => { setSearch(event.target.value); setShowAll(false) }}
          placeholder={input ? 'Find a previous node...' : 'Find a next node...'}
          aria-label={`Search ${side} node suggestions`}
          className="min-w-0 flex-1 bg-transparent text-[12px] text-[#333] outline-none placeholder:text-[#aaa]" />
        {search && <button type="button" onClick={() => setSearch('')} aria-label="Clear search" className="cursor-pointer text-[#888]"><X size={14} /></button>}
      </div>
      <div className="max-h-[min(43dvh,340px)] overflow-y-auto border-t border-[#ededf0] [scrollbar-width:thin]">
        {existingMatches.length > 0 && <div>
          <p className="px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.1em] text-[#999]">Already in workflow</p>
          {existingMatches.slice(0, limit).map(node => <div key={node.id} className="flex min-h-10 items-center gap-2 border-t border-[#ededed] px-3 hover:bg-white">
            {nodeIcon(node, catalog)}
            <span className="min-w-0 flex-1 truncate text-[12px] text-[#454545]">{labelOf(node, catalog)}</span>
            {actions(input ? node.type : selected.type, branch => attachExisting(node, branch))}
          </div>)}
        </div>}
        {newMatches.length > 0 && <div>
          <p className="px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.1em] text-[#999]">Add a new node</p>
          {newMatches.slice(0, limit).map(item => <div key={item.type} className="flex min-h-11 items-center gap-2 border-t border-[#ededed] px-3 hover:bg-white">
            <WorkflowToolIcon type={item.type} label={item.label} size={21} />
            <div className="min-w-0 flex-1">
              <p className="truncate text-[12px] text-[#454545]">{item.label}</p>
              <p className="truncate text-[10px] text-[#a0a0a0]">{item.group}</p>
            </div>
            {actions(input ? item.type : selected.type, branch => addAndAttach(item, branch), true)}
          </div>)}
        </div>}
        {!existingMatches.length && !newMatches.length && <p className="px-3 py-5 text-center text-[12px] text-[#888]">No matching available nodes.</p>}
      </div>
      {(existingMatches.length > limit || newMatches.length > limit) && <button type="button"
        onClick={() => setShowAll(current => !current)}
        className="w-full cursor-pointer border-t border-[#ededed] px-3 py-2 text-center text-[11px] font-medium text-[#7a54b4] hover:bg-white">
        {showAll ? 'Show fewer' : `Show more suggestions (${existingMatches.length + newMatches.length})`}
      </button>}
      <p className="border-t border-[#ececf0] px-3 py-1.5 text-[10px] text-[#999]">
        Suggestions use available catalog nodes and declared data types. Review settings after connecting.
      </p>
    </div>}
  </div>
}
