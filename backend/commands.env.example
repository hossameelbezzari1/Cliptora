# Copy this file as backend/commands.env and edit it locally.
# These secrets remain server-side. NEVER commit the real file to Git.
# Allowed public HTTPS API hostnames, separated by commas, exact match:
CLIPTORA_COMMAND_ALLOWED_HOSTS=api.example.com
# Optional token sent as Bearer only to allowlisted hosts:
CLIPTORA_COMMAND_HTTP_TOKEN=
# Selenium: use a dedicated Chrome profile, or a trusted local .pkl containing Selenium cookies.
# Do not use the default Chrome profile while Chrome is running.
CLIPTORA_SELENIUM_PROFILE_DIR=
CLIPTORA_SELENIUM_COOKIES_PKL=
CLIPTORA_SELENIUM_HEADLESS=0
