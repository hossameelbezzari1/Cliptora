ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/cliptora_v2?charset=utf8mb4
SECRET_KEY=SET-AT-LEAST-32-RANDOM-CHARACTERS-BEFORE-STORING-CREDENTIALS
SESSION_DAYS=14
MAX_UPLOAD_MB=250
STORAGE_DIR=../storage
FRONTEND_ORIGIN=http://localhost:5173
WORKFLOW_QUEUE=local
REDIS_URL=redis://127.0.0.1:6379/0
CLIPTORA_WORKFLOW_MAX_UPLOAD_MB=4096
# Exact comma-separated HTTPS hosts allowed by the native HTTP Request workflow node.
# Example: api.example.com,api.openai.com
CLIPTORA_WORKFLOW_HTTP_ALLOWED_HOSTS=
