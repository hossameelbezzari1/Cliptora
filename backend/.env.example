ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/cliptora_v2?charset=utf8mb4
SECRET_KEY=replace-this-with-a-long-random-secret-before-production
SESSION_DAYS=14
MAX_UPLOAD_MB=250
STORAGE_DIR=../storage
FRONTEND_ORIGIN=http://localhost:5173
WORKFLOW_QUEUE=local
REDIS_URL=redis://127.0.0.1:6379/0
CLIPTORA_WORKFLOW_MAX_UPLOAD_MB=4096
CLIPTORA_OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# The n8n API key is created in n8n Settings > API and is used only by FastAPI.
N8N_BASE_URL=http://127.0.0.1:5678
N8N_EDITOR_PATH=/n8n
N8N_API_KEY=
# Generate a long random value and enter the same value in the n8n CLIPTORA API credential.
CLIPTORA_N8N_SERVICE_TOKEN=
